    {
      "tags": {
        "allowUnknownTags": true,
        "dictionaries": ["jsdoc", "closure"]
      },
      "source": {
        "include": ["src"], 
        "includePattern": ".+\\.(js|ts)$",
        "excludePattern": "(^|\\/|\\\\)_"
      },
      "plugins": ["node_modules/better-docs/typescript"],
      "templates": {
        "cleverLinks": true,
        "monospaceLinks": true,
        "better-docs": {
          "name": "My TypeScript Project Docs"
        }
      },
      "opts": {
        "encoding": "utf8",
        "destination": "./docs",
        "recurse": true,
        "template": "node_modules/better-docs"
      }
    }